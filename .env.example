# ============================================================
#  .env — signing and upload credentials for Taskfile.yml. Copy to .env and fill in.
#  .env is gitignored: NEVER commit it (this repository is public).
# ============================================================

# --- App Store Connect API key (uploads, notarization, provisioning without Xcode UI) ---
# App Store Connect › Users and Access › Integrations › App Store Connect API › Team Keys.
# Role: Admin (needed for cloud-managed Developer ID signing; App Manager is enough otherwise).
# Download AuthKey_<KEY_ID>.p8 once and keep it in ~/.appstoreconnect/private_keys/
ASC_KEY_ID=
ASC_ISSUER_ID=

# --- Signing keychain ---
# macOS unlocks keychains per session: from SSH or a remote terminal the login keychain is
# locked and codesign fails with errSecInternalComponent. A dedicated keychain holding only the
# signing certificates, unlocked by every task with this password, fixes that for good:
#   1. Keychain Access › right-click "Apple Development: …" › Export… › cert.p12
#   2. task keychain:setup -- ~/cert.p12     (creates the keychain, imports, allows codesign)
#   3. same for "Developer ID Application" once you have it (Mac direct distribution)
# Leave both empty to use the login keychain (fine in a local, unlocked session).
# A name is looked up in ~/Library/Keychains; a path is used as is.
BUILD_KEYCHAIN=kvmclient-build.keychain-db
BUILD_KEYCHAIN_PASSWORD=
