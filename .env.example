# ============================================================
#  .env — signing and upload credentials for Taskfile.yml. Copy to .env and fill in.
#  .env is gitignored: NEVER commit it (this repository is public).
# ============================================================

# --- App Store Connect API key (uploads, notarization, provisioning without Xcode UI) ---
# App Store Connect › Users and Access › Integrations › App Store Connect API › Team Keys.
# Role: Admin (needed for cloud-managed Developer ID signing; App Manager is enough otherwise).
# Download AuthKey_<KEY_ID>.p8 once and keep it in ~/.appstoreconnect/private_keys/
ASC_KEY_ID=
ASC_ISSUER_ID=

# --- Signing keychain (optional) ---
# Only needed when signing from a session where the login keychain is locked (SSH, build agent):
# codesign then fails with errSecInternalComponent. Point to a keychain holding the
# "Apple Development" certificate (archive) and, if you have it, "Developer ID Application" (DMG).
# Leave empty to use the login keychain as is.
#   security create-keychain -p <password> ~/Library/Keychains/kvmclient-build.keychain-db
#   security import <certificate.p12> -k ~/Library/Keychains/kvmclient-build.keychain-db -T /usr/bin/codesign
#   security list-keychains -d user -s ~/Library/Keychains/kvmclient-build.keychain-db $(security list-keychains -d user | tr -d '"')
BUILD_KEYCHAIN=
BUILD_KEYCHAIN_PASSWORD=
