<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only standard TLS/DTLS from the OS and WebRTC: exempt from export documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Arbitrary loads only: adding NSAllowsLocalNetworking would make the OS ignore it, and self-signed
	     KVMs reached over Tailscale/ZeroTier (not "local") would fail ATS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
