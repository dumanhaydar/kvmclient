<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Developer ID build (GitHub releases) and Debug: not sandboxed, because capturing ⌘Tab/⌘Space
	     needs an active HID event tap (Accessibility permission). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
